---
import { type MatchupRow, pts, url, weekUrl } from "../lib/data";

interface Props {
  m: MatchupRow;
  year: number;
  label?: string;
}
const { m, year, label } = Astro.props;
const homeWon = m.completed && m.away && m.home.score > m.away.score;
const awayWon = m.completed && m.away && m.away.score > m.home.score;
---

<a
  class="matchup"
  href={weekUrl(year, m.week, m.id)}
  data-box={m.away && m.completed ? url(`/box/${year}/${m.id}/`) : undefined}
  data-game={`${year}-${m.id}`}
  aria-label={`${m.home.owner} vs ${m.away?.owner ?? "bye"}, box score`}
>
  {label && <div class="label">{label}{m.weeks > 1 && ` · ${m.weeks} weeks`}</div>}
  <div class:list={["side", { won: homeWon, lost: awayWon }]}>
    <span>{m.home.owner}</span>
    <span class="num">{m.completed ? pts(m.home.score) : "—"}</span>
  </div>
  {
    m.away ? (
      <div class:list={["side", { won: awayWon, lost: homeWon }]}>
        <span>{m.away.owner}</span>
        <span class="num">{m.completed ? pts(m.away.score) : "—"}</span>
      </div>
    ) : (
      <div class="side bye muted">Bye</div>
    )
  }
  <span class="hint">Box score →</span>
</a>

<style>
  .matchup {
    position: relative;
    display: block;
    color: var(--text);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 9px 12px 9px;
    min-width: 0;
    overflow: hidden;
    transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s;
  }
  .matchup:hover {
    text-decoration: none;
    transform: translateY(-2px);
    border-color: var(--accent);
    box-shadow: 0 6px 18px rgb(0 0 0 / 0.08);
  }
  .label { font-size: 0.66rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); margin-bottom: 4px; font-weight: 600; }
  .side { display: flex; justify-content: space-between; gap: 8px; padding: 2px 0; }
  .won { font-weight: 700; color: var(--heading); }
  .won .num { color: var(--win); }
  .lost { opacity: 0.65; }
  .bye { font-style: italic; }
  .hint {
    position: absolute;
    right: 10px;
    bottom: -18px;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    transition: bottom 0.2s;
  }
  .matchup:hover .hint { bottom: 3px; }
  .matchup:hover .side:last-of-type { opacity: 0.25; }
</style>
