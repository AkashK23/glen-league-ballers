---
import Base from "../layouts/Base.astro";
import StandingsTable from "../components/StandingsTable.astro";
import Matchup from "../components/Matchup.astro";
import WrittenRanking from "../components/WrittenRanking.astro";
import Trophy from "../components/Trophy.astro";
import Toilet from "../components/Toilet.astro";
import { type MatchupRow, completedSeasons, currentSeason, league, record, slug, url, writtenRankings } from "../lib/data";

const reigning = completedSeasons[0];
const champRow = reigning?.standings.find((t) => t.final_rank === 1);
const oldestFirst = completedSeasons.slice().reverse();

let currentWeek = 0;
let latestGames: MatchupRow[] = [];
const latestRanking = currentSeason ? writtenRankings(currentSeason.year).at(-1) : undefined;
if (currentSeason) {
  const played = currentSeason.matchups.filter((m) => m.completed && m.kind === "regular");
  currentWeek = Math.max(0, ...played.map((m) => m.week));
  latestGames = played.filter((m) => m.week === currentWeek);
}
---

<Base
  heroTitle={league.hero_title || `Welcome to the ${league.name}`}
  heroSub={`The history, statistics, and records of the ${league.name} Fantasy Football League`}
  hero="home"
  tall
>
  <p slot="hero" class="tagline">{league.tagline}</p>

  {
    reigning && champRow && (
      <section class="reigning">
        <h2 class="section-title">Reigning {reigning.year} Champion: {reigning.champion}</h2>
        <a class="big-trophy" href={url(`/seasons/${reigning.year}`)}>
          <Trophy size={220} />
          <span class="shine" />
        </a>
        <p class="center muted">
          <strong>{champRow.team_name}</strong> · {record(champRow.wins, champRow.losses, champRow.ties)} · beat {reigning.runner_up} in the final
        </p>
      </section>
    )
  }

  {
    currentSeason && (
      <section>
        <h2 class="section-title">The {currentSeason.year} Season · Week {currentWeek}</h2>
        <div class:list={["grid", { "grid-2": latestRanking }]}>
          {latestRanking && (
            <div class="card">
              <h3>Power rankings · {latestRanking.title}</h3>
              <WrittenRanking ranking={latestRanking} season={currentSeason} limit={3} />
              <a class="small" href={url(`/seasons/${currentSeason.year}/power-rankings/${latestRanking.id}/`)}>Read the full rankings →</a>
            </div>
          )}
          <div class="card">
            <h3>Standings</h3>
            <StandingsTable rows={currentSeason.standings} limit={6} compact playoffTeams={currentSeason.playoff_team_count} />
            <a class="small" href={url(`/seasons/${currentSeason.year}`)}>Full standings →</a>
          </div>
        </div>
        {latestGames.length > 0 && (
          <>
            <h3 class="results-head">Week {currentWeek} results · tap a game for the box score</h3>
            <div class="games stagger">
              {latestGames.map((m) => <Matchup m={m} year={currentSeason.year} />)}
            </div>
          </>
        )}
      </section>
    )
  }

  <section>
    <h2 class="section-title">Hall of Champions</h2>
    <div class="hall stagger">
      {
        oldestFirst.map((s) => (
          <a class="hall-item" href={url(`/seasons/${s.year}`)}>
            <Trophy size={130} />
            <span class="cap">{s.year} {league.short_name} Champion</span>
            <strong>{s.champion}</strong>
          </a>
        ))
      }
    </div>
  </section>

  <section>
    <h2 class="section-title">Hall of Shame</h2>
    <div class="hall stagger">
      {
        oldestFirst.map((s) => (
          <a class="hall-item shame" href={url(`/owners/${slug(s.last_place!)}`)}>
            <Toilet size={110} />
            <span class="cap">{s.year} {league.short_name} Loser</span>
            <strong>{s.last_place}</strong>
          </a>
        ))
      }
    </div>
  </section>
</Base>

<style>
  .tagline { font-style: italic; text-transform: uppercase; font-weight: 600; letter-spacing: 0.04em; margin-top: 18px; text-shadow: 0 1px 10px rgb(0 0 0 / 0.5); }
  .big-trophy { position: relative; display: block; width: fit-content; margin: 0 auto 12px; overflow: hidden; color: var(--text); }
  .big-trophy :global(svg) { display: block; animation: float 5s ease-in-out infinite; }
  @keyframes float { 50% { transform: translateY(-8px); } }
  .shine {
    position: absolute;
    inset: 0;
    background: linear-gradient(105deg, transparent 35%, rgb(255 255 255 / 0.65) 50%, transparent 65%);
    transform: translateX(-120%);
    animation: shine 4.5s ease-in-out 1.2s infinite;
    mix-blend-mode: overlay;
    pointer-events: none;
  }
  @keyframes shine { 0%, 60% { transform: translateX(-120%); } 85%, 100% { transform: translateX(120%); } }
  .results-head { margin: 28px 0 10px; }
  .games { display: grid; gap: 10px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 210px), 1fr)); }
  .hall {
    display: grid;
    gap: 34px 12px;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    max-width: 640px;
    margin: 0 auto;
  }
  .hall-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    color: var(--heading);
    font-size: 0.78rem;
    line-height: 1.35;
  }
  .hall-item:hover { text-decoration: none; }
  .hall-item :global(svg) { transition: transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1), filter 0.35s; margin-bottom: 10px; }
  .hall-item:hover :global(svg) { transform: translateY(-8px) scale(1.06); filter: drop-shadow(0 10px 12px rgb(0 0 0 / 0.18)); }
  .hall-item.shame:hover :global(svg) { transform: rotate(-6deg) scale(1.05); }
  .cap { color: var(--text); }
  .hall-item strong { text-transform: uppercase; letter-spacing: 0.04em; }
  @media (min-width: 700px) { .hall { grid-template-columns: repeat(4, 1fr); } }
</style>
