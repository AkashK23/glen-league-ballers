---
import Base from "../layouts/Base.astro";
import StandingsTable from "../components/StandingsTable.astro";
import Matchup from "../components/Matchup.astro";
import { type MatchupRow, completedSeasons, currentSeason, league, records, record, slug, url } from "../lib/data";

const reigning = completedSeasons[0];
const champRow = reigning?.standings.find((t) => t.final_rank === 1);

const trophies = (records.playoffs.most_championships as any[]).filter((r) => r.championships > 0);

let currentWeek = 0;
let latestGames: MatchupRow[] = [];
if (currentSeason) {
  const played = currentSeason.matchups.filter((m) => m.completed && m.kind === "regular");
  currentWeek = Math.max(0, ...played.map((m) => m.week));
  latestGames = played.filter((m) => m.week === currentWeek);
}
---

<Base>
  <section class="hero">
    <p class="eyebrow">Est. {league.first_year} · {completedSeasons.length} seasons</p>
    <h1>{league.name}</h1>
    <p class="tagline">The history, statistics and records of the league.{league.tagline && <em> {league.tagline}.</em>}</p>
  </section>

  <div class="grid grid-2">
    {
      reigning && champRow && (
        <a class="card champion" href={url(`/seasons/${reigning.year}`)}>
          <span class="pill gold">Reigning {reigning.year} champion</span>
          <div class="trophy">🏆</div>
          <div class="champ-name">{reigning.champion}</div>
          <div class="muted">{champRow.team_name}</div>
          <div class="small muted">
            {record(champRow.wins, champRow.losses, champRow.ties)} regular season · beat {reigning.runner_up} in the final
          </div>
        </a>
      )
    }

    {
      currentSeason && (
        <div class="card">
          <div class="row-head">
            <h3>{currentSeason.year} season · Week {currentWeek}</h3>
            <a class="small" href={url(`/seasons/${currentSeason.year}`)}>Full standings →</a>
          </div>
          <StandingsTable rows={currentSeason.standings} limit={6} compact playoffTeams={currentSeason.playoff_team_count} />
        </div>
      )
    }
  </div>

  {
    latestGames.length > 0 && (
      <>
        <h2>Week {currentWeek} results</h2>
        <div class="games">
          {latestGames.map((m) => (
            <Matchup m={m} />
          ))}
        </div>
      </>
    )
  }

  <div class="grid grid-2 halls">
    <section>
      <h2>Hall of Champions</h2>
      <div class="card">
        <table>
          <tbody>
            {
              completedSeasons.map((s) => (
                <tr>
                  <td class="year"><a href={url(`/seasons/${s.year}`)}>{s.year}</a></td>
                  <td>🏆 <a href={url(`/owners/${slug(s.champion!)}`)}><strong>{s.champion}</strong></a></td>
                  <td class="muted small team">{s.standings.find((t) => t.final_rank === 1)?.team_name}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>

    <section>
      <h2>Hall of Shame</h2>
      <div class="card">
        <table>
          <tbody>
            {
              completedSeasons.map((s) => (
                <tr>
                  <td class="year"><a href={url(`/seasons/${s.year}`)}>{s.year}</a></td>
                  <td class="shame">💩 <a href={url(`/owners/${slug(s.last_place!)}`)}>{s.last_place}</a></td>
                  <td class="muted small team">{s.standings[s.standings.length - 1]?.team_name}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>
  </div>

  <h2>Trophy case</h2>
  <div class="trophies">
    {
      trophies.map((r) => (
        <a class="card trophy-card" href={url(`/owners/${slug(r.owner)}`)}>
          <div class="cups">{"🏆".repeat(r.championships)}</div>
          <div class="owner">{r.owner}</div>
          <div class="muted small">
            {r.championships} title{r.championships > 1 ? "s" : ""} · {r.appearances} playoff trips
          </div>
        </a>
      ))
    }
  </div>
</Base>

<style>
  .hero { padding: 12px 0 28px; }
  .eyebrow {
    color: var(--accent);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 0.8rem;
    margin: 0 0 6px;
  }
  .tagline { color: var(--muted); font-size: 1.05rem; margin: 0; }
  .champion {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 4px;
    color: var(--text);
    background: linear-gradient(160deg, var(--accent-soft), var(--surface) 70%);
  }
  .champion:hover { text-decoration: none; border-color: var(--accent); }
  .trophy { font-size: 3.5rem; line-height: 1; margin: 10px 0 4px; }
  .champ-name {
    font-family: var(--font-display);
    font-size: 2.25rem;
    font-weight: 700;
    text-transform: uppercase;
  }
  .row-head { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; flex-wrap: wrap; }
  .games { display: grid; gap: 10px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 220px), 1fr)); }
  .year { width: 4em; font-weight: 600; }
  .team { max-width: 200px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .shame a { color: var(--shame); }
  .trophies { display: grid; gap: 12px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 170px), 1fr)); }
  .trophy-card { color: var(--text); text-align: center; }
  .trophy-card:hover { text-decoration: none; border-color: var(--accent); }
  .cups { font-size: 1.4rem; letter-spacing: 2px; }
  .owner { font-family: var(--font-display); font-size: 1.3rem; text-transform: uppercase; font-weight: 600; }
</style>
