---
import Base from "../../layouts/Base.astro";
import StandingsTable from "../../components/StandingsTable.astro";
import Matchup from "../../components/Matchup.astro";
import { type SeasonData, playoffRoundName, pts, seasonNotes, seasons, slug, url } from "../../lib/data";

export function getStaticPaths() {
  return seasons.map((s) => ({ params: { year: String(s.year) }, props: { season: s } }));
}

const { season: s } = Astro.props as { season: SeasonData };
const notes = seasonNotes(s.year);
const prev = seasons.find((x) => x.year === s.year - 1);
const next = seasons.find((x) => x.year === s.year + 1);

const byWeek = (kind: string) => {
  const weeks = new Map<number, typeof s.matchups>();
  for (const m of s.matchups.filter((m) => m.kind === kind)) {
    if (!weeks.has(m.week)) weeks.set(m.week, []);
    weeks.get(m.week)!.push(m);
  }
  return [...weeks.entries()].sort((a, b) => a[0] - b[0]);
};
const regularWeeks = byWeek("regular").filter(([, ms]) => ms.some((m) => m.completed));
const playoffWeeks = byWeek("playoff");
const consolationWeeks = byWeek("consolation");
const playoffWeekNums = playoffWeeks.map(([w]) => w);
const latestWeek = regularWeeks.at(-1)?.[0];

// Season highs and lows from one-week games
const scores = s.matchups
  .filter((m) => m.completed && m.kind !== "consolation" && m.weeks === 1)
  .flatMap((m) => [m.home, ...(m.away ? [m.away] : [])].map((side) => ({ ...side, week: m.week })))
  .filter((x) => x.score > 0);
const high = scores.reduce((a, b) => (b.score > a.score ? b : a), scores[0]);
const low = scores.reduce((a, b) => (b.score < a.score ? b : a), scores[0]);
const pfLeader = s.standings.reduce((a, b) => (b.points_for > a.points_for ? b : a), s.standings[0]);

const hasBids = s.draft.some((p) => p.bid_amount);
const draftRounds = [...new Set(s.draft.map((p) => p.round))];
---

<Base title={String(s.year)}>
  <div class="season-nav small">
    {prev ? <a href={url(`/seasons/${prev.year}`)}>← {prev.year}</a> : <span />}
    <a href={url("/seasons")}>All seasons</a>
    {next ? <a href={url(`/seasons/${next.year}`)}>{next.year} →</a> : <span />}
  </div>

  <h1>{s.year} season</h1>
  <p class="muted">{s.league_name} · {s.standings.length} teams · {s.regular_season_weeks}-week regular season · {s.playoff_team_count}-team playoff</p>

  {
    s.complete ? (
      <div class="banner card">
        <div>
          <span class="pill gold">Champion</span>
          <div class="big">🏆 <a href={url(`/owners/${slug(s.champion!)}`)}>{s.champion}</a></div>
          <div class="muted small">{s.standings[0].team_name}</div>
        </div>
        <div class="facts">
          <div><span class="muted small">Runner-up</span><br />{s.runner_up}</div>
          <div><span class="muted small">Last place</span><br />💩 {s.last_place}</div>
          <div><span class="muted small">Points leader</span><br />{pfLeader.owner} ({pts(pfLeader.points_for)})</div>
          {high && <div><span class="muted small">High score</span><br />{high.owner} {pts(high.score)} <span class="muted small">(Wk {high.week})</span></div>}
          {low && <div><span class="muted small">Low score</span><br />{low.owner} {pts(low.score)} <span class="muted small">(Wk {low.week})</span></div>}
        </div>
      </div>
    ) : (
      <p><span class="pill gold">In progress</span> <span class="muted small">Through week {latestWeek}</span></p>
    )
  }

  {
    notes && (
      <section class="card prose notes">
        {notes.frontmatter.player_of_the_year && (
          <p><span class="pill gold">Player of the year</span> <strong>{notes.frontmatter.player_of_the_year}</strong></p>
        )}
        <notes.Content />
      </section>
    )
  }

  <h2>{s.complete ? "Final standings" : "Standings"}</h2>
  <div class="card">
    <StandingsTable rows={s.standings} final={s.complete} playoffTeams={s.playoff_team_count} />
  </div>

  {
    playoffWeeks.length > 0 && (
      <>
        <h2>Playoffs</h2>
        <div class="bracket">
          {playoffWeeks.map(([week, ms]) => (
            <div class="round">
              <h3>{playoffRoundName(week, playoffWeekNums)}</h3>
              {ms.filter((m) => m.away).map((m) => <Matchup m={m} label={`Week ${week}`} />)}
              {ms.filter((m) => !m.away).map((m) => <div class="muted small">Bye: {m.home.owner}</div>)}
            </div>
          ))}
        </div>
        {consolationWeeks.length > 0 && (
          <details>
            <summary>Consolation bracket</summary>
            <div class="bracket">
              {consolationWeeks.map(([week, ms]) => (
                <div class="round">
                  <h3>Week {week}</h3>
                  {ms.filter((m) => m.away).map((m) => <Matchup m={m} />)}
                </div>
              ))}
            </div>
          </details>
        )}
      </>
    )
  }

  <h2>Weekly results</h2>
  {
    regularWeeks
      .slice()
      .reverse()
      .map(([week, ms]) => (
        <details class="week" open={!s.complete && week === latestWeek}>
          <summary>Week {week}</summary>
          <div class="games">
            {ms.map((m) => <Matchup m={m} />)}
          </div>
        </details>
      ))
  }

  {
    s.draft.length > 0 && (
      <>
        <h2>Draft</h2>
        <details class="card">
          <summary>{draftRounds.length} rounds · {s.draft.length} picks</summary>
          <div class="table-wrap">
            <table>
              <thead>
                <tr><th class="num">Rd</th><th class="num">Pick</th><th>Owner</th><th>Player</th>{hasBids && <th class="num">Bid</th>}</tr>
              </thead>
              <tbody>
                {s.draft.map((p) => (
                  <tr>
                    <td class="num">{p.round}</td>
                    <td class="num">{p.pick}</td>
                    <td>{p.owner}</td>
                    <td>{p.player}{p.keeper && <span class="pill">Keeper</span>}</td>
                    {hasBids && <td class="num">{p.bid_amount ? `$${p.bid_amount}` : ""}</td>}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </details>
      </>
    )
  }
</Base>

<style>
  .season-nav { display: flex; justify-content: space-between; margin-bottom: 12px; }
  .banner {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
    justify-content: space-between;
    align-items: center;
    background: linear-gradient(160deg, var(--accent-soft), var(--surface) 60%);
  }
  .big { font-family: var(--font-display); font-size: 2rem; font-weight: 700; text-transform: uppercase; }
  .big a { color: var(--text); }
  .facts { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 12px 24px; flex: 1; min-width: min(100%, 320px); }
  .notes { margin-top: 16px; max-width: none; }
  .bracket { display: grid; gap: 16px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 230px), 1fr)); align-items: start; }
  .round { display: flex; flex-direction: column; gap: 8px; }
  .round h3 { margin: 0; }
  .week { border-bottom: 1px solid var(--border); padding: 8px 0; }
  .week summary { font-family: var(--font-display); text-transform: uppercase; font-size: 1rem; color: var(--text); }
  .games { display: grid; gap: 10px; margin-top: 10px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 220px), 1fr)); }
  details.card summary { margin: 0; }
</style>
