---
import "../styles/global.css";
import { league, seasons, url } from "../lib/data";

interface Props {
  title?: string;
}
const { title } = Astro.props;
const pageTitle = title ? `${title} · ${league.name}` : league.name;
const path = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ""), "") || "/";
const nav = [
  { href: "/", label: "Home" },
  { href: "/seasons", label: "Seasons" },
  { href: "/records", label: "Records" },
  { href: "/rivalries", label: "Rivalries" },
  { href: "/stats", label: "Statistics" },
];
const active = (href: string) => (href === "/" ? path === "/" : path.startsWith(href));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <link rel="icon" href={url("/favicon.svg")} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Oswald:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="site-header">
      <div class="container bar">
        <a class="brand" href={url("/")}>
          <span class="mark">🏆</span>
          <span>{league.name}</span>
        </a>
        <nav>
          {nav.map((n) => <a href={url(n.href)} class:list={{ active: active(n.href) }}>{n.label}</a>)}
        </nav>
      </div>
    </header>

    <main class="container">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <div class="years">
          {seasons.map((s) => <a href={url(`/seasons/${s.year}`)}>{s.year}</a>)}
        </div>
        <p class="muted small">
          {league.tagline && <em>{league.tagline}</em>} · Stats synced from the league's fantasy platform.
        </p>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-header {
    background: var(--brand);
    color: #fff;
    position: sticky;
    top: 0;
    z-index: 10;
  }
  @media (prefers-color-scheme: dark) {
    .site-header { background: #121826; border-bottom: 1px solid var(--border); }
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 56px;
    flex-wrap: wrap;
  }
  .brand {
    color: #fff;
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    display: flex;
    align-items: center;
    gap: 8px;
    white-space: nowrap;
  }
  .brand:hover { text-decoration: none; }
  nav { display: flex; gap: 2px; overflow-x: auto; }
  nav a {
    color: rgb(255 255 255 / 0.78);
    padding: 6px 10px;
    border-radius: 6px;
    font-size: 0.9rem;
    font-weight: 500;
    white-space: nowrap;
  }
  nav a:hover { color: #fff; background: rgb(255 255 255 / 0.1); text-decoration: none; }
  nav a.active { color: #fff; background: rgb(255 255 255 / 0.16); }
  @media (max-width: 480px) {
    nav { width: 100%; justify-content: space-between; }
    nav a { padding: 6px 6px; font-size: 0.85rem; }
  }
  main { padding-top: 28px; padding-bottom: 48px; min-height: 70vh; }
  .site-footer { border-top: 1px solid var(--border); padding: 24px 0 32px; }
  .years { display: flex; flex-wrap: wrap; gap: 4px 14px; margin-bottom: 8px; font-size: 0.9rem; }
</style>
